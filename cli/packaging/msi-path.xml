<!--
  What the command line's MSI adds to jpackage's main.wxs, which the module's windowsJpackage task takes
  from the JDK whose jpackage builds the MSI: the installation folder at the end of the system's PATH,
  which Windows Installer removes again with the product. The task puts this fragment before main.wxs's
  </Wix> and a ComponentGroupRef to it beside its own of Files.

  A component needs a key path, which an Environment cannot be: a registry value of its own is. The
  component's GUID stays as it is, as Windows Installer counts the installations of a component by it.
-->
<Fragment>
  <ComponentGroup Id="DogVisionCliPath">
    <Component Id="DogVisionCliPath" Directory="INSTALLDIR" Guid="{2923fd4e-65cb-44a2-9e35-40cc1aba2c06}">
      <Environment Id="DogVisionCliPath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="yes"
                   Permanent="no"/>
      <RegistryValue Root="HKLM" Key="Software\dog-vision-cli" Name="OnPath" Type="integer" Value="1"
                     KeyPath="yes"/>
    </Component>
  </ComponentGroup>
</Fragment>
