+    private companion object {
+        private val sessionsLock = Any()
+        private var openSessions = 0
+
+        fun openSession() {
+            synchronized(sessionsLock) { openSessions++ }
+        }
+
+        /**
+         * Once no session is open, drops what [environment] remembers of the jars the sessions read.
+         *
+         * The Kotlin compiler keeps the application environment after its last project closes when
+         * `kotlin.environment.keepalive` is true, which the Kotlin Gradle plugin and Android Lint set in the
+         * Gradle daemon detekt may run in. Its jar file system reads a jar's entries once, so a class added to a
+         * jar at the same path would stay unresolved in every later run. The Kotlin daemon clears the same caches
+         * after each compilation.
+         */
+        fun closeSession(environment: CoreApplicationEnvironment?) {
+            synchronized(sessionsLock) {
+                openSessions--
+                if (openSessions == 0 && environment != null) {
+                    ZipHandler.clearFileAccessorCache()
+                    (environment.jarFileSystem as? CoreJarFileSystem)?.clearHandlersCache()
+                    (environment.jrtFileSystem as? CoreJrtFileSystem)?.clearRoots()
+                    (environment as? KotlinCoreApplicationEnvironment)?.idleCleanup()
+                }
+            }
+        }
     }
