<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI's code page: Windows-1250, Central Europe's, in place of the Windows-1252 of WiX's own English strings,
  which has no ř for the vendor's name, Martin Lopatář. light.exe takes the code page from the first localization it
  is handed, and a string defined in two would clash, so this one defines none, and the scripts in tools hand it to
  light.exe before WiX's own.
-->
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1250"/>
