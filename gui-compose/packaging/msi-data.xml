<!--
  What each window's MSI adds to jpackage's main.wxs, which tools/package_msi_on_windows.ps1 and
  tools/package_msi_on_linux.sh take from the JDK whose jpackage builds the MSI: the app's folder under
  %ProgramData%, where the window downloads ffmpeg, removed with the product, but not while a later
  version replaces it. They put the app's English name for @APP_NAME@, the package's for @NAME@ and the
  window's component GUID for @GUID@, this fragment before main.wxs's </Wix>, and a ComponentGroupRef to
  it beside its own of Files.

  RemoveFolderEx takes the folder from a property, which its custom action reads before costing, so
  SetProperty sets it before that action; it leaves it empty, so that nothing is removed, while a later
  version upgrades this one, which Windows Installer says by UPGRADINGPRODUCTCODE. Both windows download
  into the same folder, which either removes.

  A component needs a key path, which a RemoveFolderEx cannot be: a registry value of its own is. Each
  window's component GUID stays as it is, as Windows Installer counts the installations of a component by
  it, and differs from the other's, as their key paths differ.
-->
<Fragment>
  <SetProperty Id="DOGVISIONDATA" Value="[CommonAppDataFolder]@APP_NAME@\" Before="WixRemoveFoldersEx"
               Sequence="execute">NOT UPGRADINGPRODUCTCODE</SetProperty>
  <ComponentGroup Id="DogVisionData">
    <Component Id="DogVisionData" Directory="INSTALLDIR" Guid="{@GUID@}">
      <util:RemoveFolderEx On="uninstall" Property="DOGVISIONDATA"/>
      <RegistryValue Root="HKLM" Key="Software\@NAME@" Name="RemovesData" Type="integer" Value="1"
                     KeyPath="yes"/>
    </Component>
  </ComponentGroup>
</Fragment>
